<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════
         DARK THEME COLORS
    ═══════════════════════════════════════════════ -->
    <Color x:Key="BgDeepColor">#0F172A</Color>
    <Color x:Key="BgSidebarColor">#1E293B</Color>
    <Color x:Key="BgCardColor">#1E293B</Color>
    <Color x:Key="BgCardHoverColor">#334155</Color>
    <Color x:Key="AccentPrimaryColor">#6366F1</Color>
    <Color x:Key="AccentSecondaryColor">#4F46E5</Color>
    <Color x:Key="AccentLightColor">#818CF8</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextMutedColor">#A3B1C6</Color>
    <Color x:Key="BorderColor">#2D3748</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SidebarGradientStart">#1A1F35</Color>
    <Color x:Key="SidebarGradientEnd">#2D1B69</Color>
    <Color x:Key="BgIconColor">#0F172A</Color>
    <Color x:Key="BadgeBgColor">#1E293B</Color>

    <SolidColorBrush x:Key="BgDeep"          Color="{StaticResource BgDeepColor}" Opacity="0.85"/>
    <SolidColorBrush x:Key="BgSidebar"       Color="{StaticResource BgSidebarColor}" Opacity="0.95"/>
    <SolidColorBrush x:Key="BgCard"          Color="{StaticResource BgCardColor}" Opacity="1.0"/>
    <SolidColorBrush x:Key="BgCardHover"     Color="{StaticResource BgCardHoverColor}" Opacity="1.0"/>
    <SolidColorBrush x:Key="AccentPrimary"   Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentLight"     Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="TextPrimary"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"       Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}" Opacity="0.4"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="BgIcon"          Color="{StaticResource BgIconColor}" Opacity="0.6"/>
    <SolidColorBrush x:Key="BadgeBg"         Color="{StaticResource BadgeBgColor}" Opacity="0.4"/>

</ResourceDictionary>
