<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════
         LIGHT THEME COLORS (Premium Palette)
    ═══════════════════════════════════════════════ -->
    <Color x:Key="BgDeepColor">#F1F5F9</Color>
    <Color x:Key="BgSidebarColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgCardHoverColor">#F8FAFC</Color>
    <Color x:Key="AccentPrimaryColor">#4F46E5</Color>
    <Color x:Key="AccentSecondaryColor">#4338CA</Color>
    <Color x:Key="AccentLightColor">#6366F1</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="BorderColor">#CBD5E1</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SidebarGradientStart">#FFFFFF</Color>
    <Color x:Key="SidebarGradientEnd">#F1F5F9</Color>
    <Color x:Key="BgIconColor">#F1F5F9</Color>
    <Color x:Key="BadgeBgColor">#E0E7FF</Color>

    <SolidColorBrush x:Key="BgDeep"          Color="{StaticResource BgDeepColor}" Opacity="0.85"/>
    <SolidColorBrush x:Key="BgSidebar"       Color="{StaticResource BgSidebarColor}" Opacity="0.95"/>
    <SolidColorBrush x:Key="BgCard"          Color="{StaticResource BgCardColor}" Opacity="1.0"/>
    <SolidColorBrush x:Key="BgCardHover"     Color="{StaticResource BgCardHoverColor}" Opacity="1.0"/>
    <SolidColorBrush x:Key="AccentPrimary"   Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentLight"     Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="TextPrimary"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"       Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}" Opacity="0.3"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="BgIcon"          Color="{StaticResource BgIconColor}" Opacity="0.5"/>
    <SolidColorBrush x:Key="BadgeBg"         Color="{StaticResource BadgeBgColor}" Opacity="0.4"/>

</ResourceDictionary>
