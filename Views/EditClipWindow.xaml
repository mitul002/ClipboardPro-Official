<Window x:Class="ClipboardPro.Views.EditClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Clip" Width="1000" Height="750" MinWidth="500" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="{DynamicResource GlobalOpacity}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">

    <Border Background="{DynamicResource BgDeep}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="10" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Main Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Image Editor Tools -->
                <RowDefinition Height="*"/>    <!-- Row 2: Content -->
            </Grid.RowDefinitions>

            <!-- Main Header -->
            <Border Grid.Row="0" Height="48" Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="Edit" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="ChkPinned" Cursor="Hand" Width="32" Height="32" Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock x:Name="TxtPin" FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Opacity="0.8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TxtPin" Property="Text" Value="&#xE840;"/>
                                            <Setter TargetName="TxtPin" Property="Opacity" Value="1"/>
                                            <Setter TargetName="TxtPin" Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BadgeBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BadgeBg}"/>
                                            <Setter TargetName="TxtPin" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ToggleButton x:Name="ChkFavorite" Cursor="Hand" Width="32" Height="32" Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock x:Name="TxtFav" FontFamily="Segoe MDL2 Assets" Text="&#xEB51;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Opacity="0.8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TxtFav" Property="Text" Value="&#xEB52;"/>
                                            <Setter TargetName="TxtFav" Property="Opacity" Value="1"/>
                                            <Setter TargetName="TxtFav" Property="Foreground" Value="#F43F5E"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#331F22"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#331F22"/>
                                            <Setter TargetName="TxtFav" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button x:Name="BtnSwitchToEdit" Click="BtnSwitchToEdit_Click" Style="{DynamicResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" FontSize="14" Width="32" Height="32" Margin="0,0,4,0" Foreground="{DynamicResource AccentPrimary}" Visibility="Collapsed" ToolTip="Switch to Edit Mode"/>
                        <Button x:Name="BtnSave" Click="BtnSave_Click" Style="{DynamicResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE74E;" FontSize="14" Width="32" Height="32" Margin="0,0,4,0" Foreground="{DynamicResource TextPrimary}"/>
                        <Button Click="BtnClose_Click" Style="{DynamicResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE711;" FontSize="14" Width="32" Height="32" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Image Editor Tools (Second Row) -->
            <Border x:Name="ImageTools" Grid.Row="1" Height="44" Padding="12,0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ToolPencil" IsChecked="True" Style="{DynamicResource IconRadioButton}" ToolTip="Pencil (Freehand)" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextPrimary}"/>
                    <RadioButton x:Name="ToolLine" Style="{DynamicResource IconRadioButton}" ToolTip="Line" Content="&#xE108;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextPrimary}"/>
                    <RadioButton x:Name="ToolBox" Style="{DynamicResource IconRadioButton}" ToolTip="Rectangle" Content="&#xE739;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextPrimary}"/>
                    <RadioButton x:Name="ToolCircle" Style="{DynamicResource IconRadioButton}" ToolTip="Ellipse" Content="&#xEA3A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextPrimary}"/>
                    <RadioButton x:Name="ToolArrow" Style="{DynamicResource IconRadioButton}" ToolTip="Arrow" Content="&#xE111;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextPrimary}"/>
                    <RadioButton x:Name="ToolEraser" Style="{DynamicResource IconRadioButton}" ToolTip="Eraser (Clears Ink &amp; Shapes)" Content="&#xED60;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextPrimary}"/>
                    
                    <Separator Width="1" Margin="4,8" Background="{DynamicResource BorderBrush}"/>
                    
                    <!-- Thickness -->
                    <ComboBox x:Name="CmbThickness" Style="{DynamicResource DarkComboBox}" Width="60" Height="28" Margin="4,0" SelectionChanged="CmbThickness_SelectionChanged" ToolTip="Stroke Thickness">
                        <ComboBoxItem Content="1px" Tag="1"/>
                        <ComboBoxItem Content="2px" Tag="2"/>
                        <ComboBoxItem Content="3px" Tag="3" IsSelected="True"/>
                        <ComboBoxItem Content="5px" Tag="5"/>
                        <ComboBoxItem Content="8px" Tag="8"/>
                    </ComboBox>

                    <Separator Width="1" Margin="4,8" Background="{DynamicResource BorderBrush}"/>
                    <Button Click="BtnUndo_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="Undo (Ctrl+Z)" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                    
                    <Separator Width="1" Margin="4,8" Background="{DynamicResource BorderBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#EF4444" IsChecked="True" Tag="#EF4444" Click="Color_Click" ToolTip="Red"/>
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#10B981" Tag="#10B981" Click="Color_Click" ToolTip="Green"/>
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#3B82F6" Tag="#3B82F6" Click="Color_Click" ToolTip="Blue"/>
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#F59E0B" Tag="#F59E0B" Click="Color_Click" ToolTip="Yellow"/>
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#8B5CF6" Tag="#8B5CF6" Click="Color_Click" ToolTip="Purple"/>
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#000000" Tag="#000000" Click="Color_Click" ToolTip="Black" BorderBrush="White" BorderThickness="1"/>
                        <RadioButton Style="{DynamicResource ColorRadioButton}" Background="#FFFFFF" Tag="#FFFFFF" Click="Color_Click" ToolTip="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <Button Click="BtnMoreColors_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="More Colors" Margin="4,0,0,0" Width="28" Height="28">
                            <Ellipse Width="16" Height="16">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EF4444" Offset="0.0" />
                                        <GradientStop Color="#F59E0B" Offset="0.33" />
                                        <GradientStop Color="#10B981" Offset="0.66" />
                                        <GradientStop Color="#3B82F6" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Button>
                    </StackPanel>
                    <Separator Width="1" Margin="4,8" Background="{DynamicResource BorderBrush}"/>
                    <Button Click="BtnClearDraw_Click" Style="{DynamicResource IconButtonStyle}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Clear All" Margin="4,0,0,0" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>

                    <Separator Width="1" Margin="8,8" Background="{DynamicResource BorderBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Button Click="BtnZoomOut_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="Zoom Out" Content="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtZoom" Text="100%" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0" FontSize="11" Width="36" TextAlignment="Center"/>
                        <Button Click="BtnZoomIn_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="Zoom In" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                        <Button Click="BtnZoomReset_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="Reset Zoom" Content="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="2" Margin="12">
                <!-- Text Mode -->
                <Border x:Name="TextContainer" Background="{DynamicResource BgCard}" CornerRadius="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox x:Name="TxtContent" Style="{DynamicResource InputBox}" Tag="New York, United States" AcceptsReturn="True" TextWrapping="Wrap" 
                             VerticalContentAlignment="Top"
                             BorderThickness="0" Background="Transparent" Padding="12" FontSize="13"
                             VerticalScrollBarVisibility="Auto" MinHeight="80"/>
                </Border>

                <Border x:Name="ImageContainer" Visibility="Collapsed" Background="{DynamicResource BgCard}" CornerRadius="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <ScrollViewer x:Name="ImageScroller" PanningMode="Both" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#08000000" PreviewMouseWheel="ImageScroller_PreviewMouseWheel" Style="{DynamicResource SlimScrollViewer}">
                        <Grid x:Name="DrawingGrid" Background="Transparent" 
                               MouseDown="DrawingGrid_MouseDown" MouseMove="DrawingGrid_MouseMove" MouseUp="DrawingGrid_MouseUp"
                               IsManipulationEnabled="True" ManipulationDelta="DrawingGrid_ManipulationDelta"
                               Cursor="Cross" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="ImgDisplay" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <InkCanvas x:Name="DrawCanvas" Background="Transparent" EditingMode="Ink" IsHitTestVisible="False">
                                <InkCanvas.DefaultDrawingAttributes>
                                    <DrawingAttributes Color="Red" Width="3" Height="3" FitToCurve="True"/>
                                </InkCanvas.DefaultDrawingAttributes>
                            </InkCanvas>
                            <Canvas x:Name="ShapeCanvas" Background="{x:Null}" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
