<Window x:Class="ClipboardPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipboardPro" Height="750" Width="1200" MinWidth="800" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="{DynamicResource GlobalOpacity}"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ClipboardPro.ico"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      GlassFrameThickness="0" 
                      CornerRadius="12" 
                      ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource BgDeep}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" CenterX="450" CenterY="300"/>
                <TranslateTransform x:Name="RootTranslate"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="200" MaxWidth="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" CornerRadius="12,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="100" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/logo.png" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ClipboardPro" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="The Smart Copy Space" Foreground="{DynamicResource TextSecondary}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
                        <Button Click="BtnShare_Click" Style="{StaticResource SidebarNavButton}" Padding="0" Margin="0,0,0,8"
                                Visibility="{Binding ActivePeers.Count, Converter={StaticResource CountToVisibility}, FallbackValue=Collapsed}">
                            <Border Background="{DynamicResource BadgeBg}" CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE975;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentPrimary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActivePeers.Count, StringFormat='{}{0} devices nearby'}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button x:Name="BtnSettings" Style="{StaticResource SidebarNavButton}" Click="BtnSettings_Click">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Style="{StaticResource SlimScrollViewer}" Margin="12,0">
                        <StackPanel>

                            <Button x:Name="BtnAllItems" Click="NavButton_Click" Tag="All Items"
                                    Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="All Items" FontSize="14" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeAll" Background="{DynamicResource AccentPrimary}"
                                            CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtBadgeAll" Text="{Binding TotalCount, FallbackValue=0}" FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnFavorites" Click="NavButton_Click" Tag="Favorites"
                                    Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Favorites" FontSize="14" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtBadgeFav" Text="{Binding FavoriteCount, FallbackValue=0}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnPinned" Click="NavButton_Click" Tag="Pinned"
                                    Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Pinned" FontSize="14" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtBadgePin" Text="{Binding PinnedCount, FallbackValue=0}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Snippets (Text Expander) - fixed above CATEGORIES so it never moves -->
                            <Button x:Name="BtnSnippets" Click="NavButton_Click" Tag="Snippets"
                                    Style="{StaticResource SidebarNavButton}"
                                    Visibility="{Binding Settings.EnableTextExpander, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimary}"/>
                                    <TextBlock Text="Expander" FontSize="14" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeSnippets" Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtBadgeSnippets" Text="{Binding SnippetCount, FallbackValue=0}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="CATEGORIES" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" FontWeight="Bold" Margin="12,16,0,8"/>

                            <Button Click="NavButton_Click" Tag="URL"   Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                    Visibility="{Binding UrlCount, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="URL" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding UrlCount, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Click="NavButton_Click" Tag="Email" Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                    Visibility="{Binding EmailCount, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Email" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding EmailCount, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Click="NavButton_Click" Tag="Code"  Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                    Visibility="{Binding CodeCount, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Code" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding CodeCount, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Click="NavButton_Click" Tag="Phone" Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                    Visibility="{Binding PhoneCount, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phone" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PhoneCount, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Click="NavButton_Click" Tag="Image" Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                    Visibility="{Binding ImageCount, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Image" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ImageCount, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                             <Button Click="NavButton_Click" Tag="Color" Style="{StaticResource SidebarNavButton}"
                                     AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                     Visibility="{Binding ColorCount, Converter={StaticResource CountToVisibility}}">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                     <TextBlock Text="Colors" VerticalAlignment="Center"/>
                                     <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Width="20" Height="20" Margin="8,0,0,0">
                                         <TextBlock Text="{Binding ColorCount, FallbackValue=0}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                 </StackPanel>
                             </Button>

                             <Button Click="NavButton_Click" Tag="Path" Style="{StaticResource SidebarNavButton}"
                                     AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                     Visibility="{Binding PathCount, Converter={StaticResource CountToVisibility}}">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                     <TextBlock Text="File Received" VerticalAlignment="Center"/>
                                     <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Width="20" Height="20" Margin="8,0,0,0">
                                         <TextBlock Text="{Binding PathCount, FallbackValue=0}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                 </StackPanel>
                             </Button>

                             <Button Click="NavButton_Click" Tag="Directory" Style="{StaticResource SidebarNavButton}"
                                     AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                     Visibility="{Binding DirectoryCount, Converter={StaticResource CountToVisibility}}">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                     <TextBlock Text="Directory" VerticalAlignment="Center"/>
                                     <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Width="20" Height="20" Margin="8,0,0,0">
                                         <TextBlock Text="{Binding DirectoryCount, FallbackValue=0}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                 </StackPanel>
                             </Button>

                             <Button Click="NavButton_Click" Tag="Private" Style="{StaticResource SidebarNavButton}"
                                    AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver"
                                    Visibility="{Binding PrivateCount, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Private" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PrivateCount, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnAddCategory" Click="BtnAddCategory_Click"
                                    Style="{StaticResource AddCategoryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Category" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <ItemsControl ItemsSource="{Binding CustomCategoryInfos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SidebarNavButton}"
                                                Tag="{Binding Name, StringFormat='cat:{0}'}"
                                                Click="NavButton_Click"
                                                AllowDrop="True" Drop="SidebarButton_Drop" DragEnter="SidebarButton_DragEnter" DragOver="SidebarButton_DragOver">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding Color}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                
                                                <Border Grid.Column="2" Background="{DynamicResource BadgeBg}" CornerRadius="10" Width="20" Height="20" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Count, FallbackValue=0}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Button Grid.Column="3" x:Name="BtnEditCategory" Click="BtnEditCategory_Click" Tag="{Binding .}"
                                                        Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource TextMuted}"
                                                        Width="24" Height="24" Margin="4,0,0,0"
                                                        ToolTip="Edit Category">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="TitleBar" Grid.Row="0" Height="40" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                        <!-- Theme Toggle (Sun/Moon) -->
                        <Button x:Name="BtnThemeToggle" Style="{StaticResource IconButtonStyle}" Click="BtnThemeToggle_Click" Width="34" Height="34">
                            <TextBlock x:Name="TxtThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Quick Paste Bar Toggle -->
                        <Button x:Name="BtnQuickPasteBar" Style="{StaticResource IconButtonStyle}" Width="34" Height="34" Margin="0,0,4,0"
                                ToolTip="Quick Paste Bar"
                                Click="BtnQuickPasteBar_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE945;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.EnableQuickPasteBar}" Value="True">
                                                <Setter Property="Foreground" Value="#f1c40f"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Always on Top Toggle -->
                        <Button x:Name="BtnAlwaysOnTop" Width="34" Height="34" Margin="0,0,10,0"
                                ToolTip="Always on Top"
                                Click="BtnAlwaysOnTop_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Content" Value="&#xE718;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AlwaysOnTop}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                            <Setter Property="Content" Value="&#xE840;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Width="34" Height="34"
                                Style="{StaticResource IconButtonStyle}"
                                Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Width="34" Height="34"
                                Style="{StaticResource IconButtonStyle}"
                                Click="BtnMaximize_Click"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Width="34" Height="34"
                                Style="{StaticResource IconButtonStyle}"
                                Foreground="{DynamicResource DangerBrush}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="24,0,24,24">
                    <DockPanel LastChildFill="False">
                        <!-- LEFT SIDE: Search & Sort -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="250" Margin="0,0,10,0">
                                <Grid>
                                    <TextBox Style="{StaticResource SearchBox}" Height="40"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Grid Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                          Visibility="{Binding IsSearchLoading, Converter={StaticResource BoolToVisibility}}"
                                          RenderTransformOrigin="0.5, 0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform />
                                        </Grid.RenderTransform>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <Trigger Property="IsVisible" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard Name="Spin">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Spin"/>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Path Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 8,1 A 7,7 0 1 1 1,8" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <ComboBox x:Name="CmbSort" Style="{StaticResource DarkComboBox}" Height="40" Width="120" Margin="0,0,10,0" SelectionChanged="CmbSort_SelectionChanged">
                                <ComboBoxItem Content="Newest First" IsSelected="True"/>
                                <ComboBoxItem Content="Oldest First"/>
                                <ComboBoxItem Content="A-Z"/>
                                <ComboBoxItem Content="Z-A"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- RIGHT SIDE: Actions (Refresh, Delete, Share, View Toggles) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BgSidebar}" CornerRadius="8" Padding="2" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BtnListView" IsChecked="{Binding IsGridView, Converter={StaticResource InverseBooleanConverter}}"
                                                  Style="{StaticResource ViewToggleStyle}" Content="&#xE179;" ToolTip="List View"/>
                                    <ToggleButton x:Name="BtnGridView" IsChecked="{Binding IsGridView}"
                                                  Style="{StaticResource ViewToggleStyle}" Content="&#xE80A;" ToolTip="Grid View"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnRefresh" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ToolTip="Refresh List"
                                    Width="40" Height="40" Margin="0,0,10,0" Click="BtnRefresh_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnClearAll" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Clear All History"
                                    Width="40" Height="40" Click="BtnClearAll_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnShareAction" Content="&#xEC26;" FontFamily="Segoe MDL2 Assets" ToolTip="Local File Share"
                                    Width="40" Height="40" Margin="10,0,0,0" Click="BtnShare_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- MIDDLE: Filters (Date, Type) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbDate" Height="40" Width="120" Margin="0,0,10,0" SelectionChanged="CmbDate_SelectionChanged">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveFilter}" Value="Snippets">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBoxItem Content="All Dates" IsSelected="True"/>
                                <ComboBoxItem Content="Today"/>
                                <ComboBoxItem Content="Yesterday"/>
                                <ComboBoxItem Content="This Week"/>
                                <ComboBoxItem Content="This Month"/>
                            </ComboBox>

                            <ComboBox x:Name="CmbType" Height="40" Width="120" SelectionChanged="CmbType_SelectionChanged">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveFilter}" Value="Snippets">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBoxItem Content="All Types" IsSelected="True"/>
                                <ComboBoxItem Content="Text"/>
                                <ComboBoxItem Content="Images"/>
                                <ComboBoxItem Content="Links"/>
                                <ComboBoxItem Content="Code"/>
                                <ComboBoxItem Content="Email"/>
                                <ComboBoxItem Content="Phone"/>
                                <ComboBoxItem Content="Colors"/>
                                <ComboBoxItem Content="Files"/>
                                <ComboBoxItem Content="Directory"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2" Margin="24,0,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>                    </Grid.RowDefinitions>

                    <!-- Page Title & Add Snippet Button aligned -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20">
                        <TextBlock x:Name="TxtPageTitle" Text="{Binding FilterTitle}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>

                        <Button x:Name="BtnAddSnippet" Click="BtnAddSnippet_Click"
                                DockPanel.Dock="Right" VerticalAlignment="Center"
                                Height="38" Padding="18,0"
                                Background="{DynamicResource AccentPrimary}" Foreground="White"
                                FontWeight="Bold" FontSize="13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveFilter}" Value="Snippets">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Snippet" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- ── SNIPPETS VIEW (Text Expander) ───────────────────── -->
                    <Grid x:Name="PanelSnippets" Grid.Row="1" Visibility="Collapsed">
                        <!-- Snippets List -->
                        <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                            <ItemsControl ItemsSource="{Binding FilteredSnippets}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel IsItemsHost="True"/>
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SnippetCard" CornerRadius="12" BorderThickness="1" Margin="0,0,12,12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                            <Setter Property="Width" Value="250"/>
                                                            <Setter Property="Height" Value="220"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- LIST VIEW LAYOUT -->
                                                <Grid x:Name="SnippetListLayout" Margin="16,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border CornerRadius="8" Padding="10,4" Margin="0,0,14,0" Background="{DynamicResource BadgeBg}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Trigger}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentPrimary}"/>
                                                        </Border>
                                                        <TextBlock Text="→" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Opacity="0.4"/>
                                                        <TextBlock Text="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="350" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" Tag="{Binding .}" Click="BtnEditSnippet_Click" Width="32" Height="32" Margin="2,0" ToolTip="Edit Snippet" Foreground="{DynamicResource AccentPrimary}"/>
                                                        <Grid>
                                                            <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" Tag="{Binding .}" Click="BtnCopySnippet_Click" Width="32" Height="32" Margin="2,0" ToolTip="Copy Content" Foreground="{DynamicResource AccentPrimary}"/>
                                                            <Border x:Name="CopyFeedbackList" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="4,2" IsHitTestVisible="False" Opacity="0" VerticalAlignment="Top" Margin="0,30,0,-10">
                                                                <TextBlock Text="Copied" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Tag="{Binding .}" Click="BtnDeleteSnippet_Click" Width="32" Height="32" Margin="2,0" ToolTip="Delete Snippet" Foreground="{DynamicResource DangerBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- GRID VIEW LAYOUT (Matches Clipboard Style) -->
                                                <Grid x:Name="SnippetGridLayout" Visibility="Collapsed">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Header: Badge & Time -->
                                                    <Grid Grid.Row="0" Margin="12,8,12,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource BadgeBg}">
                                                                <TextBlock Text="snippet" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding RelativeTime}" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Preview Area -->
                                                    <Border Grid.Row="1" Background="{DynamicResource BgIcon}" CornerRadius="8" Margin="10,0" MinHeight="100">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                                            <TextBlock Text="{Binding Trigger}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Metadata Area (Description if any) -->
                                                    <StackPanel Grid.Row="2" Margin="10,5,10,0" Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}">
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AccentLight}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Actions Area -->
                                                    <Border Grid.Row="3" Background="Transparent" Padding="4,4">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" Tag="{Binding .}" Click="BtnEditSnippet_Click" Width="28" Height="28" FontSize="12" ToolTip="Edit"/>
                                                            <Grid>
                                                                <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" Tag="{Binding .}" Click="BtnCopySnippet_Click" Width="28" Height="28" FontSize="12" ToolTip="Copy"/>
                                                                <Border x:Name="CopyFeedbackGrid" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="4,2" IsHitTestVisible="False" Opacity="0" VerticalAlignment="Top" Margin="0,30,0,-10">
                                                                    <TextBlock Text="Copied" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Tag="{Binding .}" Click="BtnDeleteSnippet_Click" Foreground="{DynamicResource DangerBrush}" Width="28" Height="28" FontSize="12" ToolTip="Delete"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                <Setter TargetName="SnippetListLayout" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="SnippetGridLayout" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            </DataTemplate.Triggers>
                                            </DataTemplate>                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── MAIN CLIPBOARD LIST ───────────────────────────── -->

                    <ListBox x:Name="MainListBox" Grid.Row="1" ItemsSource="{Binding FilteredItems}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,0,4,0">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Style="{StaticResource SlimScrollViewer}" CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <ContentPresenter x:Name="Presenter">
                                                    <ContentPresenter.RenderTransformOrigin>0.5,0.5</ContentPresenter.RenderTransformOrigin>
                                                    <ContentPresenter.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            <TranslateTransform Y="0"/>
                                                        </TransformGroup>
                                                    </ContentPresenter.RenderTransform>
                                                </ContentPresenter>
                                                
                                                <Rectangle x:Name="SelectionBar" Width="4" Height="30" HorizontalAlignment="Left" 
                                                           VerticalAlignment="Center" Fill="{DynamicResource AccentPrimary}" 
                                                           RadiusX="2" RadiusY="2" Visibility="Collapsed" Margin="0,0,0,12"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Converter={StaticResource GridWidthConverter}}"/>
                                        <Setter Property="Height" Value="220"/>
                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                        <Setter Property="Height" Value="135"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Margin="0,0,12,12"
                                        RenderTransformOrigin="0.5,0.5"
                                        Cursor="Hand" 
                                        PreviewMouseLeftButtonDown="CardBorder_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="CardBorder_PreviewMouseLeftButtonUp"
                                        PreviewMouseMove="CardBorder_PreviewMouseMove"
                                        DataContextChanged="CardBorder_DataContextChanged">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid x:Name="MainCardGrid">
                                        <Grid x:Name="ListViewLayout" Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" x:Name="ListThumbnail" Width="80" Height="80" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BgIcon}" VerticalAlignment="Top"
                                                    Cursor="Hand" Tag="Thumbnail">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToImage}, IsAsync=True}" Stretch="UniformToFill" Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                    
                                                    <!-- Eye Icon Overlay -->
                                                    <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding .}" Click="BtnView_Click"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                            Width="22" Height="22" Background="Transparent"
                                                            Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}">
                                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                                    </Button>

                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ImagePath, Converter={StaticResource InverseNullToVisibility}}" Foreground="{DynamicResource TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE8A5;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TypeBadge}" Value="url">   <Setter Property="Text" Value="&#xE71B;"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeBadge}" Value="email"> <Setter Property="Text" Value="&#xE715;"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeBadge}" Value="code">  <Setter Property="Text" Value="&#xE943;"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeBadge}" Value="phone"> <Setter Property="Text" Value="&#xE717;"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeBadge}" Value="image"> <Setter Property="Text" Value="&#xE8B9;"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Column="1" Margin="12,4,8,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelativeTime}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,12,0"/>
                                                        <Border CornerRadius="6" Padding="8,2" Background="{DynamicResource BadgeBg}" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}"/>
                                                        </Border>
                                                        
                                                        <!-- Smart Feature: Color Preview -->
                                                        <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                Visibility="{Binding DetectedColor, Converter={StaticResource NullToVisibility}}">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding DetectedColor, FallbackValue=#00000000}"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <!-- Smart Feature: Sensitive Mask Toggle -->
                                                        <Button Tag="{Binding .}" Click="BtnToggleMask_Click" Width="28" Height="28" ToolTip="Reveal/Hide"
                                                                Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                                    <Setter Property="Content" Value="&#xED1A;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMasked}" Value="False">
                                                                            <Setter Property="Content" Value="&#xE890;"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Smart Feature: JSON Formatter -->
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE943;" Tag="{Binding .}" Click="BtnPrettify_Click" Width="28" Height="28" ToolTip="Structure/Prettify JSON"
                                                                Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibility}}"/>

                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" Tag="{Binding .}" Click="BtnEdit_Click" Width="28" Height="28" ToolTip="Edit"/>
                                                        <Button FontFamily="Segoe MDL2 Assets" Tag="{Binding .}" Click="BtnPin_Click" Width="28" Height="28" ToolTip="Pin">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                    <Setter Property="Content" Value="&#xE718;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                            <Setter Property="Content" Value="&#xE840;"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button FontFamily="Segoe MDL2 Assets" Tag="{Binding .}" Click="BtnFavorite_Click" Width="28" Height="28" ToolTip="Favorite">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                    <Setter Property="Content" Value="&#xEB51;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Content" Value="&#xEB52;"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8EC;" Tag="{Binding .}" Click="BtnAddCategory_Item_Click" Width="28" Height="28" ToolTip="Add to Category"/>
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8D5;" Tag="{Binding .}" Click="BtnVisitFolder_Click" Width="28" Height="28" Visibility="{Binding Type, Converter={StaticResource TypeToVisibility}, ConverterParameter='Image|Path|Directory'}" ToolTip="Visit Folder"/>
                                                        <Grid Margin="2,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Vertical">
                                                                <Button Tag="{Binding .}" Click="BtnSend_Click" Width="28" Height="28" ToolTip="Send to Device">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                                            <Setter Property="Content" Value="&#xE724;"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{Binding SendingBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <TextBlock Text="{Binding SendingPercentage, StringFormat={}{0:0}%}" 
                                                                           FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource SuccessBrush}"
                                                                           Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"
                                                                           Margin="0,-4,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid>
                                                            <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" Tag="{Binding .}" Click="BtnCopy_Click" Width="28" Height="28" ToolTip="Copy"/>                                                            <Border x:Name="CopyFeedbackList" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="4,2" IsHitTestVisible="False" Opacity="0" VerticalAlignment="Top" Margin="0,30,0,-10">
                                                                <TextBlock Text="Copied" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Tag="{Binding .}" Click="BtnDelete_Click" Foreground="{DynamicResource DangerBrush}" Width="28" Height="28" ToolTip="Delete"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- URL Title as Header -->
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource AccentLight}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{Binding Title, Converter={StaticResource NullToVisibility}}"/>

                                                <TextBox Grid.Row="2" Text="{Binding MaskedContent, Mode=OneWay}" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60" Foreground="{DynamicResource TextPrimary}" FontSize="13" IsReadOnly="True" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Title, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                    <Setter Property="FontSize" Value="11"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </Grid>

                                        <Grid x:Name="GridViewLayout" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header: Badge & Time -->
                                            <Grid Grid.Row="0" Margin="12,8,12,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource BadgeBg}">
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding RelativeTime}" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Preview Area -->
                                                                                         <Border Grid.Row="1" x:Name="GridThumbnail" Background="{DynamicResource BgIcon}" CornerRadius="8" ClipToBounds="True" Margin="10,0" MinHeight="100" Cursor="Hand" Tag="Thumbnail">
                                                <Grid>
                                                    <!-- Image Preview -->
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToImage}, IsAsync=True}" Stretch="UniformToFill" Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                    
                                                    <!-- Eye Icon Overlay for Images -->
                                                     <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding .}" Click="BtnView_Click"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                            Width="22" Height="22" Background="Transparent"
                                                            Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}">
                                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                                    </Button>

                                                    <!-- Color Preview -->
                                                    <Border Background="{Binding DetectedColor, FallbackValue=Transparent}" 
                                                            Visibility="{Binding Type, Converter={StaticResource TypeToVisibility}, ConverterParameter=Color}"
                                                            Margin="20" CornerRadius="8">
                                                        <TextBlock Text="{Binding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                                   Foreground="White" FontWeight="Bold" FontSize="12">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Text Preview (If not Image or Color) -->
                                                    <TextBlock Text="{Binding MaskedContent}" Padding="12" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding ImagePath, Converter={StaticResource NullToVisibility}}" Value="Collapsed"/>
                                                                            <Condition Binding="{Binding Type, Converter={StaticResource TypeToVisibility}, ConverterParameter=Color}" Value="Collapsed"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!-- Metadata Area (Title) -->
                                            <StackPanel Grid.Row="2" Margin="10,5,10,0" Visibility="{Binding Title, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentLight}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Actions Area -->
                                            <Border Grid.Row="3" Background="Transparent" Padding="4,4">
                                                <WrapPanel HorizontalAlignment="Center">
                                                    <!-- Reveal/Hide -->
                                                    <Button Tag="{Binding .}" Click="BtnToggleMask_Click" Width="28" Height="28" ToolTip="Reveal/Hide"
                                                            Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                                <Setter Property="Content" Value="&#xED1A;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMasked}" Value="False">
                                                                        <Setter Property="Content" Value="&#xE890;"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Prettify JSON -->
                                                    <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE943;" Tag="{Binding .}" Click="BtnPrettify_Click" Width="28" Height="28" ToolTip="Prettify JSON"
                                                            Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibility}}"/>

                                                    <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" Tag="{Binding .}" Click="BtnEdit_Click" Width="28" Height="28" FontSize="12" ToolTip="Edit"/>
                                                    
                                                    <Button FontFamily="Segoe MDL2 Assets" Tag="{Binding .}" Click="BtnPin_Click" Width="28" Height="28" FontSize="12" ToolTip="Pin">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                <Setter Property="Content" Value="&#xE718;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Content" Value="&#xE840;"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button FontFamily="Segoe MDL2 Assets" Tag="{Binding .}" Click="BtnFavorite_Click" Width="28" Height="28" FontSize="12" ToolTip="Favorite">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                <Setter Property="Content" Value="&#xEB51;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Content" Value="&#xEB52;"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8EC;" Tag="{Binding .}" Click="BtnAddCategory_Item_Click" Width="28" Height="28" FontSize="12" ToolTip="Add to Category"/>
                                                    <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8D5;" Tag="{Binding .}" Click="BtnVisitFolder_Click" Width="28" Height="28" FontSize="12" ToolTip="Visit Folder" Visibility="{Binding Type, Converter={StaticResource TypeToVisibility}, ConverterParameter='Image|Path|Directory'}"/>
                                                    
                                                    <!-- Send to Device -->
                                                    <Grid VerticalAlignment="Center">
                                                        <StackPanel Orientation="Vertical">
                                                            <Button Tag="{Binding .}" Click="BtnSend_Click" Width="28" Height="28" ToolTip="Send to Device">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                                        <Setter Property="Content" Value="&#xE724;"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSending}" Value="True">
                                                                                <Setter Property="Foreground" Value="{Binding SendingBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <TextBlock Text="{Binding SendingPercentage, StringFormat={}{0:0}%}" 
                                                                       FontSize="7" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource SuccessBrush}"
                                                                       Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"
                                                                       Margin="0,-4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid>
                                                        <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" Tag="{Binding .}" Click="BtnCopy_Click" Width="28" Height="28" FontSize="12" ToolTip="Copy"/>
                                                        <Border x:Name="CopyFeedbackGrid" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="4,2" IsHitTestVisible="False" Opacity="0" VerticalAlignment="Top" Margin="0,30,0,-10">
                                                            <TextBlock Text="Copied" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>

                                                    <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Tag="{Binding .}" Click="BtnDelete_Click" Foreground="{DynamicResource DangerBrush}" Width="28" Height="28" FontSize="12" ToolTip="Delete"/>
                                                </WrapPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                        <Setter TargetName="GridViewLayout" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="ListViewLayout" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
            <ResizeGrip Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Foreground="{DynamicResource TextMuted}" Width="16" Height="16"/>

            <!-- Multi-Undo Snackbar Container -->
            <ItemsControl Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                          Margin="0,0,0,40" ItemsSource="{Binding ActiveUndos}" Panel.ZIndex="999">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,8,0,0" Padding="20,12" CornerRadius="16"
                                Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13" FontWeight="SemiBold"/>
                                    <Button Content="UNDO" Foreground="{DynamicResource AccentPrimary}" FontWeight="Bold" FontSize="13"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding .}" Click="BtnUndo_Click"/>
                                    <TextBlock Text="{Binding Countdown, StringFormat='({0}s)'}" Foreground="{DynamicResource TextMuted}" 
                                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding Progress}" Height="3" Margin="0,10,0,0" 
                                             Background="#15888888" BorderThickness="0" Foreground="{DynamicResource AccentPrimary}"
                                             Minimum="0" Maximum="100"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
