<Window x:Class="ClipboardPro.Views.QuickDropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDrop" Height="50" Width="50" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" 
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Hover visual state changes -->
        <Storyboard x:Key="OnMouseEnter">
            <DoubleAnimation Storyboard.TargetName="BubbleBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             To="1.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="BubbleScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             To="1.08" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="BubbleScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             To="1.08" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="OnMouseLeave">
            <DoubleAnimation Storyboard.TargetName="BubbleBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0.8" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="BubbleScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             To="1.0" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="BubbleScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="Transparent">
        <!-- Circular Floating Bubble -->
        <Border x:Name="BubbleBorder" 
                Width="44" Height="44" 
                Background="{DynamicResource BgSidebar}" 
                CornerRadius="22" 
                BorderBrush="{DynamicResource AccentPrimary}" 
                BorderThickness="2" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Opacity="0.85"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <!-- Main Icon -->
                <TextBlock x:Name="IconTxt" 
                           Text="&#xE8C8;" 
                           FontFamily="Segoe MDL2 Assets" 
                           FontSize="15" 
                           Foreground="{DynamicResource AccentPrimary}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           IsHitTestVisible="False"/>
                
                <!-- Badge for Item Count -->
                <Border x:Name="BadgeBorder" 
                        Background="{DynamicResource DangerBrush}" 
                        CornerRadius="8" 
                        Width="16" Height="16" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,0,0,0"
                        Visibility="Collapsed" 
                        Cursor="Hand"
                        PreviewMouseLeftButtonDown="BadgeBorder_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="BadgeBorder_PreviewMouseLeftButtonUp">
                    <TextBlock x:Name="TxtBadge" 
                               Text="0" 
                               Foreground="White" 
                               FontSize="9" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Premium Shelf Flyout Popup -->
        <Popup x:Name="ShelfPopup" 
               PlacementTarget="{Binding ElementName=BubbleBorder}"
               Placement="Left" 
               StaysOpen="True" 
               AllowsTransparency="True"
               PopupAnimation="Fade" 
               Closed="ShelfPopup_Closed"
               Opened="ShelfPopup_Opened">
            <Border x:Name="PopupContentBorder"
                    Background="{DynamicResource BgDeep}" 
                    CornerRadius="14"
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1"
                    MinWidth="300" 
                    MaxWidth="360" 
                    MaxHeight="420"
                    Padding="0,12,0,0"
                    PreviewMouseDown="PopupContentBorder_PreviewMouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Shelf Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="14,0,14,12">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="15" 
                                       Margin="0,0,8,0" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource AccentPrimary}"/>
                            <TextBlock Text="Temporary Shelf" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" 
                                Content="Clear All" 
                                FontSize="11"
                                Height="24" 
                                Padding="10,0"
                                Style="{StaticResource IconButtonStyle}"
                                Foreground="{DynamicResource DangerBrush}"
                                Click="BtnClearShelf_Click"/>
                    </DockPanel>

                    <!-- Scrollable Content Stack -->
                    <ScrollViewer Grid.Row="1" 
                                  Style="{StaticResource SlimScrollViewer}" 
                                  MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  VerticalContentAlignment="Stretch">
                        <Grid x:Name="ShelfSelectionGrid" Background="Transparent" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top spacer for more lasso area -->
                                <RowDefinition Height="*"/>    <!-- Items -->
                                <RowDefinition Height="Auto"/> <!-- Footer Tip -->
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Height="8" Background="Transparent"/>

                            <StackPanel x:Name="ShelfItemsPanel" Grid.Row="1" MinHeight="120" Margin="14,0,14,0">
                                <!-- Populated dynamically via UIHelper -->
                            </StackPanel>

                            <!-- Footer Tip moved inside lasso area -->
                            <TextBlock Grid.Row="2" 
                                       Text="Drag items out to paste them elsewhere" 
                                       FontSize="10"
                                       HorizontalAlignment="Center" 
                                       Margin="0,16,0,16" 
                                       Foreground="{DynamicResource TextSecondary}" 
                                       Opacity="0.6"
                                       IsHitTestVisible="False"/>

                            <!-- Lasso selection box -->
                            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                                <Rectangle x:Name="SelectionBox" Visibility="Collapsed" 
                                           Fill="#330078D7" Stroke="#0078D7" StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- Drop Zone (Welcoming Empty State) -->
                    <Border x:Name="ShelfEmptyState" 
                            Grid.Row="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1.5" 
                            CornerRadius="10"
                            AllowDrop="True" 
                            Drop="Shelf_Drop"
                            DragEnter="Shelf_DragEnter" 
                            DragOver="Shelf_DragOver"
                            DragLeave="Shelf_DragLeave"
                            Margin="14,0,14,12"
                            Padding="20,30" 
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="36"
                                       HorizontalAlignment="Center" 
                                       Foreground="{DynamicResource AccentPrimary}" 
                                       Opacity="0.5" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Drop items here" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       HorizontalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Drag files, texts or links to store them temporarily" 
                                       FontSize="11"
                                       HorizontalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}" 
                                       Opacity="0.7"
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
