<Window x:Class="ClipboardPro.Views.QuickPasteBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Paste Bar" Height="40" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">

    <Grid>
        <!-- Main bar border -->
        <Border Background="{DynamicResource BgDeep}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Restored Pin Icon -->
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="#f1c40f" Margin="8,0,10,0" FontSize="14"/>

                <!-- Virtualized Horizontal List -->
                <ListBox x:Name="MainScroll" Grid.Column="1" 
                         ItemsSource="{Binding FilteredItems}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         Background="Transparent" BorderThickness="0"
                         PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="30" Margin="2,0" Padding="8,0" Click="Item_Click" Tag="{Binding .}"
                                    PreviewMouseDown="Item_PreviewMouseDown" PreviewMouseMove="Item_PreviewMouseMove">
                                <Button.ContextMenu>
                                    <ContextMenu Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <MenuItem Header="Structure/Prettify JSON" Click="BtnPrettify_Click" Tag="{Binding .}" 
                                                  Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibility}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimary}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Pin/Unpin" Click="BtnPin_Click" Tag="{Binding .}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Delete" Click="BtnDelete_Click" Tag="{Binding .}" Foreground="{DynamicResource DangerBrush}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="{DynamicResource AccentPrimary}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"
                                               Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibility}}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DetectedColor, Converter={StaticResource NullToVisibility}}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding DetectedColor, FallbackValue=#00000000}"/>
                                            </Border.Background>
                                        </Border>
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToImage}}" MaxHeight="24" Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}"/>
                                        <TextBlock Text="{Binding Preview}" MaxWidth="100" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"
                                                   Visibility="{Binding ImagePath, Converter={StaticResource InverseNullToVisibility}}"/>
                                        
                                        <!-- Sensitive Eye Toggle -->
                                        <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Margin="4,0,0,0"
                                                Click="BtnToggleMask_Click" Tag="{Binding .}" ToolTip="Show/Hide"
                                                Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xED1A;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasked}" Value="False">
                                                                <Setter Property="Text" Value="&#xE890;"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Shelf / Quick Drop Button with badge -->
                <Grid Grid.Column="2" Width="36" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="BtnShelf" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                            ToolTip="Temporary Shelf — drop files here"
                            Click="BtnShelf_Click"
                            AllowDrop="True"
                            Drop="Shelf_Drop"
                            DragEnter="Shelf_DragEnter"
                            DragOver="Shelf_DragOver"
                            DragLeave="Shelf_DragLeave">
                        <TextBlock x:Name="TxtShelfIcon" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <!-- Item count badge -->
                    <Border x:Name="ShelfBadge" Background="{DynamicResource AccentPrimary}" CornerRadius="8"
                            Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtShelfCount" Text="0" FontSize="9" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" Click="BtnClose_Click" Width="30" Foreground="{DynamicResource DangerBrush}"/>
            </Grid>
        </Border>

        <!-- Shelf Flyout Popup (shown above the bar) -->
        <Popup x:Name="ShelfPopup" PlacementTarget="{Binding ElementName=BtnShelf}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Slide">
            <Border Background="{DynamicResource BgDeep}" CornerRadius="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    MinWidth="280" MaxWidth="360" MaxHeight="400"
                    Padding="0,10,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Shelf header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="12,0,12,10">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Temporary Shelf" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Clear All" FontSize="11"
                                Height="24" Padding="8,0"
                                Style="{StaticResource IconButtonStyle}"
                                Foreground="{DynamicResource DangerBrush}"
                                Click="BtnClearShelf_Click"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" MaxHeight="300" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch">
                        <Grid x:Name="ShelfSelectionGrid" Background="Transparent" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top spacer for more lasso area -->
                                <RowDefinition Height="*"/>    <!-- Items -->
                                <RowDefinition Height="Auto"/> <!-- Footer Tip -->
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Height="8" Background="Transparent"/>

                            <StackPanel x:Name="ShelfItemsPanel" Grid.Row="1" MinHeight="120" Margin="12,0,12,0">
                                <!-- Populated in code-behind -->
                            </StackPanel>

                            <!-- Hint moved inside lasso area -->
                            <TextBlock Grid.Row="2" Text="Drag items out to paste anywhere" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,16,0,16" Foreground="{DynamicResource TextSecondary}" Opacity="0.6"
                                       IsHitTestVisible="False"/>

                            <!-- Lasso selection box -->
                            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                                <Rectangle x:Name="SelectionBox" Visibility="Collapsed" 
                                           Fill="#330078D7" Stroke="#0078D7" StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- Drop zone (shown when shelf is empty) -->
                    <Border x:Name="ShelfEmptyState" Grid.Row="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1.5" CornerRadius="10"
                            AllowDrop="True" Drop="Shelf_Drop"
                            DragEnter="Shelf_DragEnter" DragOver="Shelf_DragOver"
                            DragLeave="Shelf_DragLeave"
                            Margin="12,0,12,10"
                            Padding="20,24" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Opacity="0.4"/>
                            <TextBlock Text="Drop files here" FontSize="13" Margin="0,10,0,4"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Opacity="0.7"/>
                            <TextBlock Text="Drag any file from Explorer or browser" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Opacity="0.6"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
