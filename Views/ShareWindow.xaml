<Window x:Class="ClipboardPro.Views.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClipboardPro Share" Height="500" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="{DynamicResource GlobalOpacity}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">

    <Window.Resources>
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.0" To="2.2" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.0" To="2.2" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="Opacity" From="0.4" To="0" Duration="0:0:3"/>
            
            <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.0" To="2.2" BeginTime="0:0:1" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.0" To="2.2" BeginTime="0:0:1" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="Opacity" From="0.4" To="0" BeginTime="0:0:1" Duration="0:0:3"/>

            <DoubleAnimation Storyboard.TargetName="Pulse3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.0" To="2.2" BeginTime="0:0:2" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="Pulse3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.0" To="2.2" BeginTime="0:0:2" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="Pulse3" Storyboard.TargetProperty="Opacity" From="0.4" To="0" BeginTime="0:0:2" Duration="0:0:3"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{DynamicResource BgDeep}" CornerRadius="16" BorderBrush="#44888888" BorderThickness="1" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,10">
                <Button x:Name="BtnBack" Content="" FontFamily="Segoe MDL2 Assets" 
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}" FontSize="18"
                        Visibility="Collapsed" Click="BtnBack_Click"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Local Share" Foreground="{DynamicResource TextPrimary}" 
                               FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" 
                            FontSize="18" Click="BtnMinimize_Click" Margin="0,0,10,0"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" 
                            FontSize="18" Click="BtnClose_Click" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <!-- State 1: Discovery -->
                <Grid x:Name="DiscoveryView" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center">
                        <ItemsControl x:Name="DevicesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="100" Height="120" Margin="10" Click="Device_Click">
                                        <StackPanel>
                                            <Grid Width="64" Height="64" Margin="0,0,0,8">
                                                <Ellipse Fill="{DynamicResource BadgeBg}"/>
                                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="32" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccentPrimary}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" 
                                                       FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="ScanningState" Margin="0,20,0,0" Height="220">
                            <!-- Shifted container for circles/icon only -->
                            <Grid VerticalAlignment="Top" Margin="0,-20,0,0" Height="160">
                                <!-- Blooming Circles -->
                                <Ellipse x:Name="Pulse1" Fill="{DynamicResource AccentPrimary}" Width="105" Height="105" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Pulse2" Fill="{DynamicResource AccentPrimary}" Width="105" Height="105" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Pulse3" Fill="{DynamicResource AccentPrimary}" Width="105" Height="105" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                
                                <!-- Central Hub -->
                                <Grid Width="105" Height="105" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource BgSidebar}" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2" Opacity="0.8"/>
                                    <TextBlock Text="&#xE975;" FontFamily="Segoe MDL2 Assets" FontSize="49" FontWeight="Light"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentPrimary}"/>
                                </Grid>
                            </Grid>

                            <TextBlock Text="Searching for nearby devices..." Foreground="{DynamicResource TextMuted}" 
                                        FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- State 2: Session -->
                <Grid x:Name="SessionView" Visibility="Collapsed" Margin="20,0,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Rectangle Stroke="{DynamicResource BorderBrush}" StrokeThickness="2" 
                                   RadiusX="16" RadiusY="16" StrokeDashArray="4 2"/>
                        <Border Background="{DynamicResource BgSidebar}" CornerRadius="16"
                                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="IconDrop" Text="" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag &amp; Drop files here" Foreground="{DynamicResource TextMuted}" 
                                           FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                                <Button Content="Select Files" Style="{StaticResource SecondaryButton}" 
                                        Margin="0,24,0,0" HorizontalAlignment="Center" Click="BtnBrowse_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock Text="Recent Transfers" Foreground="{DynamicResource TextMuted}" 
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="120" Style="{StaticResource SlimScrollViewer}">
                            <ItemsControl x:Name="TransfersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgCard}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets" 
                                                           VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentPrimary}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="2" Margin="0,4,0,0" 
                                                                 Foreground="{DynamicResource AccentPrimary}" Background="#11000000" BorderThickness="0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource AccentPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    
                                                    <Button Click="BtnPause_Click" Style="{StaticResource IconButtonStyle}" 
                                                            Content="{Binding PauseIcon}" FontFamily="Segoe MDL2 Assets" 
                                                            FontSize="12" Width="24" Height="24" Margin="0,0,4,0"
                                                            Visibility="{Binding CanAction}"/>
                                                    
                                                    <Button Click="BtnCancel_Click" Style="{StaticResource IconButtonStyle}" 
                                                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                                            FontSize="12" Width="24" Height="24" Foreground="{DynamicResource DangerBrush}"
                                                            Visibility="{Binding CanAction}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Height="30" CornerRadius="0,0,16,16" Padding="20,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="1 device nearby" Foreground="{DynamicResource TextMuted}" 
                               FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" 
                                FontSize="14" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,4,0"
                                ToolTip="View History" Click="BtnViewHistory_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" 
                                FontSize="14" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,0"
                                ToolTip="Open Received Folder" Click="BtnOpenReceived_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
