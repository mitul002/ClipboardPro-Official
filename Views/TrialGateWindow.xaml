<Window x:Class="ClipboardPro.Views.TrialGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipboardPro — License Activation"
        Width="520" Height="Auto" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- ── Light Theme Fallbacks (override by DynamicResource from App) ── -->
        <SolidColorBrush x:Key="LocalBgCard"      Color="#12131E"/>
        <SolidColorBrush x:Key="LocalBgDeep"      Color="#0D0E17"/>
        <SolidColorBrush x:Key="LocalBorder"      Color="#1E2030"/>
        <SolidColorBrush x:Key="LocalTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="LocalTextSub"     Color="#94A3B8"/>
        <SolidColorBrush x:Key="LocalTextMuted"   Color="#64748B"/>

        <!-- Input Style -->
        <Style x:Key="GateInput" TargetType="TextBox">
            <Setter Property="Background"        Value="{DynamicResource BgDeep}"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush"        Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1.5"/>
            <Setter Property="Padding"           Value="14,11"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontFamily"        Value="Consolas, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="14,0"
                                       Opacity="0.5"
                                       Visibility="Collapsed"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" Color="#6366F1" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Gradient Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Color="#6366F1" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Transfer Button -->
        <Style x:Key="TransferBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#22C55E" Offset="0"/>
                                    <GradientStop Color="#15803D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Drop Shadow Wrapper -->
    <Border Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#000000" Opacity="0.60"/>
        </Border.Effect>

        <Border x:Name="RootBorder"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="14"
                MouseLeftButtonDown="Window_MouseDown">

            <StackPanel>
                <!-- ── TOP BANNER (trial expired / revoked / offline) ── -->
                <Border x:Name="BannerBorder" CornerRadius="14,14,0,0" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="BannerGrad1" Color="#1a0030" Offset="0"/>
                            <GradientStop x:Name="BannerGrad2" Color="#001830" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Window Controls -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Orientation="Horizontal">
                            <Button x:Name="BtnMinimize" Style="{StaticResource IconBtn}"
                                    Content="—" ToolTip="Minimize" Click="BtnMinimize_Click"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="BtnClose" Click="BtnClose_Click"
                                    ToolTip="Close">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="✕"/>
                            </Button>
                        </StackPanel>

                        <!-- Banner Content -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Border x:Name="IconBadge"
                                    Width="52" Height="52"
                                    CornerRadius="16"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14">
                                <Border.Background>
                                    <SolidColorBrush x:Name="IconBadgeBg" Color="#330000AA"/>
                                </Border.Background>
                                <TextBlock x:Name="TxtBannerIcon"
                                           Text="⏰"
                                           FontSize="24"
                                           FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="TxtTitle"
                                       Text="Your Free Trial Has Ended"
                                       FontSize="20" FontWeight="ExtraBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock x:Name="TxtSubHeader"
                                       Text="Your 30-day free trial is complete. Enter your license key below to unlock full access."
                                       FontSize="12" Foreground="#CBD5E1"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="20,8,20,0" LineHeight="18"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── DIVIDER LINE ── -->
                <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                <!-- ── ACTIVATION FORM ── -->
                <StackPanel Margin="28,22,28,28">

                    <!-- Key Label -->
                    <TextBlock Text="LICENSE KEY"
                               FontSize="10" FontWeight="ExtraBold"
                               Foreground="{DynamicResource AccentPrimary}"
                               Margin="0,0,0,7"/>

                    <!-- Key Input -->
                    <TextBox x:Name="TxtKey"
                             Style="{StaticResource GateInput}"
                             Height="44"
                             MaxLength="36"
                             FontSize="14" FontWeight="Bold"
                             Tag="XXXX-XXXX-XXXX-XXXX"
                             Margin="0,0,0,14"
                             KeyDown="TxtKey_KeyDown"/>

                    <!-- Email Label -->
                    <TextBlock Text="EMAIL ADDRESS"
                               FontSize="10" FontWeight="ExtraBold"
                               Foreground="{DynamicResource AccentPrimary}"
                               Margin="0,0,0,7"/>

                    <!-- Email + Activate Button Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtEmail" Grid.Column="0"
                                 Style="{StaticResource GateInput}"
                                 Height="44"
                                 FontSize="13"
                                 Tag="yourname@email.com"
                                 KeyDown="TxtEmail_KeyDown"/>

                        <Button x:Name="BtnActivate" Grid.Column="2"
                                Style="{StaticResource PrimaryBtn}"
                                Height="44"
                                Click="BtnActivate_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="12" Margin="0,1,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Activate" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Transfer Button (hidden by default) -->
                    <Button x:Name="BtnTransfer"
                            Style="{StaticResource PrimaryBtn}"
                            Content="🔄  REQUEST TRANSFER"
                            Visibility="Collapsed"
                            Margin="0,0,0,12"
                            Click="BtnTransfer_Click"/>

                    <!-- Status Message -->
                    <TextBlock x:Name="TxtMsg"
                               Text=""
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MinHeight="20" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMuted}"/>

                    <!-- Buy Link -->
                    <TextBlock HorizontalAlignment="Center" FontSize="11" Margin="0,16,0,0">
                        <Hyperlink x:Name="LinkBuy"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   TextDecorations="None"
                                   RequestNavigate="LinkBuy_RequestNavigate"
                                   NavigateUri="https://clipboardpro.vercel.app">
                            Don't have a key? Buy at <Bold>clipboardpro.vercel.app</Bold>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
